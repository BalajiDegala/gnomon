NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/gnomon
WEB_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
# Optional: key (32+ characters) used to encrypt the SMTP password saved in Site preferences.
# If unset, it is derived from ACCESS_TOKEN_SECRET; changing either means re-entering the password.
# SETTINGS_ENCRYPTION_KEY=replace-with-another-32-character-secret
# Optional: System events debug log (Reporting -> System events, system administrators only).
# SYSTEM_EVENTS_ENABLED=true
# SYSTEM_EVENT_RETENTION_DAYS=180
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-before-seeding
ADMIN_EMPLOYEE_CODE=DDI0001
