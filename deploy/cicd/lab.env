# Non-secret settings for the d2-india Gnomon CI/CD deployment.

GITLAB_HOST=gitlab.d2-india.com
GITLAB_PROJECT=univrz/gnomon
GITLAB_REPO_URL=http://gitlab.d2-india.com/univrz/gnomon.git
GITOPS_REPO_URL=http://gitlab.d2-india.com/root/platform-gitops.git

JENKINS_HOST=jenkins.d2-india.com
JENKINS_JOB=gnomon
HARBOR_HOST=harbor.d2-india.com
HARBOR_PROJECT=apps
SONAR_HOST=sonar.d2-india.com
SONAR_PROJECT_KEY=gnomon

ARGOCD_APP=gnomon
K8S_NAMESPACE=gnomon
INGRESS_HOST=gnomon.d2-india.com
INGRESS_LB_IP=10.191.0.240

STORAGE_NODE=dd-test.d2-india.com
STORAGE_HOST_PATH=/pipedev/k8s-local/gnomon-mongodb
STORAGE_CLASS=gnomon-local
STORAGE_SIZE=20Gi
