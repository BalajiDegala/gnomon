# Copy this file to config/lab.env and edit values before running scripts.

CLUSTER_NAME=d2-india-lab
INGRESS_DOMAIN=d2-india.com

CONTROL_PLANE_HOST=hb-ws-pc06.d2-india.com
CONTROL_PLANE_IP=10.191.0.40

WORKER_HOSTS=hb-ws-pp05.d2-india.com,dd-test.d2-india.com
WORKER_IPS=10.191.0.38,10.191.0.37

POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12

# Must be free LAN IPs not allocated by DHCP.
METALLB_ADDRESS_POOL=10.191.0.240-10.191.0.250
INGRESS_LB_IP=10.191.0.240
CERT_MANAGER_EMAIL=balajid@d2.com

GITLAB_HOST=gitlab.d2-india.com
HARBOR_HOST=harbor.d2-india.com
JENKINS_HOST=jenkins.d2-india.com
JENKINS_CHART_VERSION=5.9.54
JENKINS_STORAGE_CLASS=nfs-shared
JENKINS_HOME_CLAIM=jenkins-home-nfs
SONAR_HOST=sonar.d2-india.com
ARGOCD_HOST=argocd.d2-india.com
NEXUS_HOST=nexus.d2-india.com

# GitOps delivery. Keep credentials out of this file; the repository helper
# prompts for a read-only GitLab deploy-token username and password.
ARGOCD_CHART_VERSION=10.2.1
ARGOCD_CERT_ISSUER=d2-india-selfsigned
GITOPS_REPO_URL=http://gitlab.d2-india.com/root/platform-gitops.git
GITOPS_REPO_REVISION=main
GITOPS_REPO_PATH=clusters/lab/apps
GITOPS_PROJECT=platform
GITOPS_APP_NAMESPACE=demo

# End-to-end CI/CD demonstration.
CICD_DEMO_PROJECT=root/cicd-demo
CICD_DEMO_JOB=cicd-demo
CICD_DEMO_NAMESPACE=demo
CICD_DEMO_HOST=cicd-demo.d2-india.com
CICD_HARBOR_PROJECT=apps
CICD_HARBOR_REPOSITORY=cicd-demo

# Gnomon application onboarding.
GNOMON_GITLAB_PROJECT=univrz/gnomon
GNOMON_REPO_URL=http://gitlab.d2-india.com/univrz/gnomon.git
GNOMON_JENKINS_JOB=gnomon
GNOMON_NAMESPACE=gnomon
GNOMON_HOST=gnomon.d2-india.com
GNOMON_HARBOR_PROJECT=apps
GNOMON_API_REPOSITORY=gnomon-api
GNOMON_WEB_REPOSITORY=gnomon-web
GNOMON_STORAGE_CLASS=gnomon-local
GNOMON_STORAGE_SIZE=20Gi

# Use local-path for a simple lab, Longhorn for replicated storage after disks are planned.
DEFAULT_STORAGE=local-path

# Shared capacity on dd-test. Keep local-path as default until each existing
# workload has been backed up and migrated deliberately.
NFS_SERVER_IP=10.191.0.37
NFS_EXPORT_PATH=/pipedev/k8s-nfs
NFS_EXPORT_CIDR=10.191.0.0/24
NFS_STORAGE_CLASS=nfs-shared
NFS_CSI_VERSION=4.13.4
NFS_TEST_WRITER_NODE=dd-test.d2-india.com
NFS_TEST_READER_NODE=hb-ws-pp05

# Cluster time: 10.191.0.38 serves a common local reference while the
# corporate upstream is unreachable. All other Kubernetes nodes are clients.
NTP_SERVER_IP=10.191.0.38
NTP_UPSTREAM_HOST=hb-ntphost-01.d2-india.com
NTP_ALLOW_CIDR=10.191.0.0/24
