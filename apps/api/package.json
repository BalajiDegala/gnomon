{
  "name": "@gnomon/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --clean --sourcemap",
    "dev": "tsx watch src/server.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:roles": "tsx src/scripts/seed-system-roles.ts",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test ACCESS_TOKEN_SECRET=test-access-secret-with-at-least-32-characters REFRESH_TOKEN_SECRET=test-refresh-secret-with-at-least-32-characters vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gnomon/shared": "*",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "csv-parse": "^7.0.1",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jose": "latest",
    "mongoose": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "supertest": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
